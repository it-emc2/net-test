# Copy to .env and fill in. Use the SAME values as the legacy app's .env so
# the new API talks to the same database and issues compatible session tokens.

# MongoDB — must match the legacy app to reuse existing users/data.
MONGODB_URI=mongodb+srv://user:pass@cluster/....
MONGODB_DB=KonfiguratorDB

# Vigor product catalog DB (read-only). Optional — falls back to MONGODB_URI
# with dbName "vigor" when both live on the same cluster.
VIGOR_MONGODB_URI=mongodb+srv://user:pass@cluster/....

# Session token signing secret. MUST equal the legacy AUTH_SECRET so tokens
# issued by either backend validate against the other.
AUTH_SECRET=change-me-to-match-legacy

# API port (web dev server proxies /api here).
PORT=4000

# Comma-separated allowed origins for CORS (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
