<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- A signed build gets its default keychain group from application-identifier
       in the provisioning profile, so this is mainly what lets an unsigned
       simulator build reach the Keychain at all: without an entitlement,
       SecItemAdd returns -34018 (errSecMissingEntitlement) and the session
       cannot be persisted. -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)de.emc2.konfigurator</string>
  </array>
</dict>
</plist>
