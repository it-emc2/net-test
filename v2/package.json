{
  "name": "oc-v2",
  "private": true,
  "description": "EmC² Konfigurator (OC) — TypeScript rewrite. Independent of the current app in the repo root.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "npm run dev -w @oc/server",
    "dev:web": "npm run dev -w @oc/web",
    "build": "tsc -b && npm run build -w @oc/web"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.2.0",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  }
}
