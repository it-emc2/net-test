# OC v2 production settings — copy to .env on the server, fill in, never commit.
# Names are the legacy app's names wherever possible (same values can be reused).

# --- web / domain ---
OC_DOMAIN=oc.emc2.de
PUBLIC_BASE_URL=https://oc.emc2.de
OFFER_LINK_BASE=https://oc.emc2.de

# --- database (phase 1: Atlas) — least-privilege user per ADR 010 ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/
MONGODB_DB=KonfiguratorDB
# VIGOR_MONGODB_URI=   # optional, defaults to MONGODB_URI (db "vigor")

# --- sessions: MUST be the legacy app's AUTH_SECRET so logins stay valid at the switch-over ---
AUTH_SECRET=
COOKIE_SECURE=true
AP_DEFAULT_EMAIL=

# --- Bitrix24 / planning ---
BITRIX_WEBHOOK_BASE=
BITRIX_FIELD_MATERIAL_CODES=
PLANNING_API_BASE_URL=
PLANNING_API_KEY=

# --- mail ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_EMAIL=
SMTP_USER=
SMTP_PASS=
SMTP_REPLY_TO=
IMAP_HOST=
IMAP_PASS=
IMAP_SENT_FOLDER=
SIGNING_OFFICE_EMAIL=

# --- letters (onlinebrief24) ---
OB24_API_KEY=
OB24_API_SECRET=
OB24_MODE=
# OB24_BASE_URL=   # production default is the onlinebrief24 API

# --- routing / distance ---
ORS_API_KEY=
COMPANY_ADDRESS=Kornhausacker 10, Hof
COMPANY_LAT=
COMPANY_LNG=

# --- bau-formular (external lookup) — required in v2, closed without it (ADR in 4h) ---
EXTERNAL_API_KEY=

# --- Magic API (shower product search) ---
EXTERNAL_API_BASE=
EXTERNAL_API_USER=
EXTERNAL_API_PASSWORD=

# --- logs ---
LOG_LEVEL=info
